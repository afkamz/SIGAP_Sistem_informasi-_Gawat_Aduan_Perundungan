# ==============================================================================
# SIGAP Master .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend (Node.js & npm / Vite)
# ------------------------------------------------------------------------------
node_modules/
Frontend/node_modules/
dist/
Frontend/dist/
dist-ssr/
Frontend/dist-ssr/
.vite/
Frontend/.vite/
*.local
.env.local
.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 2. Backend (Python & Virtual Environment)
# ------------------------------------------------------------------------------
venv/
.venv/
env/
*/venv/
*/.venv/
*/env/
backend/sigap-backend/venv/

# Python Bytecode & Cache
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*/.pytest_cache/
.coverage
htmlcov/

# Environment Variables & Secrets
.env
backend/sigap-backend/.env
!.env.example
!backend/sigap-backend/.env.example

# Database Runtime & Uploads
*.db
*.sqlite3
backend/sigap-backend/*.db
backend/sigap-backend/uploads/*
!backend/sigap-backend/uploads/.gitkeep

# ------------------------------------------------------------------------------
# 3. Dokumen & LaTeX Temporary Build Artifacts
# ------------------------------------------------------------------------------
*.aux
*.log
*.synctex.gz
*.out
*.toc
*.fls
*.fdb_latexmk
*.bbl
*.blg
test_SIGAP.log

# ------------------------------------------------------------------------------
# 4. OS & Editor Artifacts
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

