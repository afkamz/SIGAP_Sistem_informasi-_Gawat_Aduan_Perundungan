# Konfigurasi Database
# Docker: mysql+pymysql://sigap_user:sigap_pass_2026@db:3306/sigap_db
# Local Host: mysql+pymysql://sigap_user:sigap_pass_2026@localhost:3306/sigap_db
# SQLite fallback: sqlite:///./sigap.db
DATABASE_URL=mysql+pymysql://sigap_user:sigap_pass_2026@db:3306/sigap_db

# Kunci Rahasia JWT
JWT_SECRET_KEY=sigap_super_secret_jwt_key_lamongan_2026_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# CORS Origins (pisahkan dengan koma)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8000
